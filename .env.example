# ---- Paperless ---------------------------------------------------------------
# Interne Adresse, unter der der Companion Paperless erreicht
PAPERLESS_URL=http://192.168.1.20:8000
# Adresse für Links im Browser (falls anders, z.B. per Reverse Proxy)
PAPERLESS_PUBLIC_URL=
# Paperless > Profil (oben rechts) > "API-Auth-Token"
PAPERLESS_TOKEN=

# ---- Zugang ------------------------------------------------------------------
# Passwort für die Weboberfläche (leer = kein Login, nur im vertrauenswürdigen LAN!)
APP_PASSWORD=
# Zufälliger langer Wert, z.B. `openssl rand -hex 32`
SECRET_KEY=
# Token für den Paperless-Webhook und den Kalender-Feed (leer = deaktiviert)
WEBHOOK_TOKEN=
ICS_TOKEN=
TIMEZONE=Europe/Berlin

# ---- Synchronisation ---------------------------------------------------------
SYNC_INTERVAL_MINUTES=15
# Beim ersten Start: Dokumente der letzten N Tage einlesen
INITIAL_SYNC_DAYS=90

# Paperless-Dokumenttypen -> Art (kommagetrennt). Andere Dokumente werden per
# Schlüsselwort erkannt (KEYWORD_CLASSIFICATION=false schaltet das ab).
DOCTYPES_INVOICE=Rechnung,Quittung
DOCTYPES_CONTRACT=Vertrag,Versicherung,Police
DOCTYPES_WARRANTY=Kaufbeleg,Kassenbon,Garantie
KEYWORD_CLASSIFICATION=true

# ---- AI (lokal per Ollama) ---------------------------------------------------
# none = nur Regeln, ollama = Regeln + lokales Modell für fehlende Angaben
LLM_PROVIDER=ollama
OLLAMA_URL=http://192.168.1.30:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=900
# Maximal so viele Zeichen Dokumenttext an das Modell geben (CPU-schonend)
LLM_MAX_CHARS=6000
# AI-Werte ohne Bestätigung übernehmen (Verträge werden immer bestätigt)
LLM_AUTO_ACCEPT=false
# Zeitfenster für die AI, z.B. 22-6 (nur nachts). Leer = immer. Außerhalb läuft nur die
# Regel-Erkennung; die AI-Abfrage wird im nächsten Zeitfenster automatisch nachgeholt.
LLM_ACTIVE_HOURS=
# CPU-Threads für Ollama (0 = automatisch). Z.B. 2, damit für andere Container CPU frei bleibt.
OLLAMA_NUM_THREAD=0

# ---- Paperless-Custom-Fields ----------------------------------------------------
# Namen deiner Custom Fields je Bedeutung (Groß/Klein egal, leer = nicht verwenden).
# Bereits gepflegte Werte werden übernommen: Dokumente mit Fälligkeits- oder
# Bezahlt-Datum erscheinen automatisch als Rechnung.
FIELD_AMOUNT=Betrag
FIELD_DUE_DATE=Fällig am
FIELD_PAID_ON=Bezahlt am
FIELD_CANCEL_BY=Kündigung bis
FIELD_TERM_END=Vertragsende
FIELD_WARRANTY_END=Garantie bis
# Freitext, in der App anzeigen/bearbeiten
FIELD_COMMENT=Kommentar
# Dokumentverknüpfung – wird mit den Vorgängen verbunden
FIELD_RELATED=gehört zu
# Ziel der KI-Zusammenfassung
FIELD_SUMMARY=Zusammenfassung KI
# Rechnungen ohne Bezahlt-Datum, die länger als N Tage fällig sind, gelten als erledigt
FIELDS_OPEN_MAX_AGE_DAYS=90

# Paperless wird nur gelesen. Vorschläge für diese Felder (Betrag, bezahlt am, Kommentar,
# Zusammenfassung, Verknüpfungen …) sammelt die Seite „Für Paperless“ – geschrieben wird
# erst, wenn du sie dort auswählst und übernimmst (Token braucht dann Schreibrechte).
# Fehlende Felder (Betrag, Fällig am …) bei der Übernahme anlegen
WRITEBACK_CREATE_FIELDS=true
# Beim Hinzufügen zu einem Vorgang die Verknüpfung in FIELD_RELATED vorschlagen
CASES_PROPOSE_LINKS=true

# ---- KI-Zusammenfassung --------------------------------------------------------
# off | manual (nur per Knopf) | new (automatisch für neu analysierte Dokumente)
SUMMARY_MODE=manual
# So viele Zeichen vom Dokumentanfang bekommt das Modell
SUMMARY_MAX_INPUT_CHARS=3500

# ---- Steuer-Export ------------------------------------------------------------
# Tags, die ein Dokument steuerrelevant machen. Kategorien per Tag „Steuer: Werbungskosten“,
# „Steuer/Spenden“ usw., sonst wird der Dokumenttyp als Kategorie verwendet.
TAX_TAGS=Steuer
# Zusätzlich immer steuerrelevante Dokumenttypen (kommagetrennt)
TAX_DOCTYPES=

# ---- Zahlungsabgleich mit Firefly III -----------------------------------------
# Firefly III > Optionen > Profil > OAuth > "Persönliche Zugangs-Tokens"
FIREFLY_URL=
FIREFLY_TOKEN=
FIREFLY_LOOKBACK_DAYS=120
# Eindeutige Treffer (Betrag + Rechnungsnummer oder IBAN) direkt als bezahlt markieren
FIREFLY_AUTO_ACCEPT=false

# ---- Aufbewahrung --------------------------------------------------------------
# Tag, mit dem abgelaufene Dokumente in Paperless markiert werden
RETENTION_TAG=Löschkandidat
# Direktes Löschen aus dem Companion erlauben (landet im Paperless-Papierkorb)
RETENTION_DELETE_ENABLED=false

# ---- Updates (wie im firefly-dashboard) -------------------------------------------
# Stündlich bei GitHub nach neuen Commits schauen (Anzeige unter System)
UPDATE_CHECK=true
UPDATE_REPO=stabmaster1985/paperless-companion
# Solange das Repository privat ist: Fine-grained Token, nur dieses Repo, „Contents: Read-only“
UPDATE_GITHUB_TOKEN=
# Webhook des n8n-Workflows n8n/paperless-companion-update.json (Knopf „Jetzt aktualisieren“)
UPDATE_WEBHOOK_URL=
UPDATE_WEBHOOK_HEADER=X-Update-Key
UPDATE_WEBHOOK_SECRET=

# ---- Erinnerungen ------------------------------------------------------------
REMINDER_DAYS=30,7,1
REMINDER_HOUR=8
# ntfy, z.B. https://ntfy.sh/mein-geheimes-topic oder eigener Server
NTFY_URL=
NTFY_TOKEN=
# E-Mail (Port 465 = SSL, sonst STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true
